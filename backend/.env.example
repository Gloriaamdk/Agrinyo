# Copier en backend/.env puis remplir. Toutes les variables lues par le backend sont ici.
# Une valeur vide = valeur par défaut. Ne jamais commiter le .env.

# --- Mode ---
# True en développement. False (production) : DJANGO_SECRET_KEY obligatoire.
DJANGO_DEBUG=True
# Clé secrète (sessions, CSRF), longue chaîne aléatoire :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base PostgreSQL ---
# Champs séparés…
DB_NAME=agrinyo
DB_USER=postgres
DB_PASSWORD=
# Dans l'image Docker : host.docker.internal pour une base sur la machine hôte
# (Linux : --add-host=host.docker.internal:host-gateway), sinon le nom du serveur.
DB_HOST=localhost
DB_PORT=5432
# … ou adresse complète d'un hébergeur, prioritaire si remplie :
#   postgresql://utilisateur:mot-de-passe@serveur:5432/agrinyo?sslmode=require
# (caractères spéciaux du mot de passe encodés : @ -> %40, : -> %3A, / -> %2F)
DATABASE_URL=
# require pour une base hébergée qui exige le chiffrement ; vide en local.
DB_SSLMODE=
# Réutilisation d'une connexion, en secondes (0 = une connexion par requête).
DB_CONN_MAX_AGE=60

# --- Sécurité / déploiement ---
# Adresse(s) du site React si elle diffère de celle de l'API (CORS + CSRF), ex. https://app.agrilink.tg.
# En développement, http://localhost:5173 et http://localhost:3000 sont déjà autorisés.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Lax : site et API sur le même domaine ou des sous-domaines. None : domaines sans rapport (exige HTTPS).
DJANGO_COOKIES_SAMESITE=Lax
# Domaine parent (ex. .agrilink.tg) pour un cookie CSRF lisible par le site ; vide = jeton par /api/csrf/.
DJANGO_CSRF_COOKIE_DOMAIN=
# Vide = automatique (sécurisés hors DEBUG). False seulement pour un essai en HTTP sans DEBUG.
DJANGO_SECURE_COOKIES=
# True quand l'API est servie en HTTPS derrière un proxy ou un hébergeur.
DJANGO_HTTPS=False
# HSTS (si DJANGO_HTTPS=True) : commencer court, puis 31536000 (un an).
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_SOUS_DOMAINES=False
# Nombre de proxys devant gunicorn (ex. 1), pour limiter les essais par adresse du client ; vide sans proxy.
DJANGO_NUM_PROXIES=
# Photos servies par Django hors DEBUG (image Docker sans serveur web devant).
DJANGO_SERVIR_MEDIA=True

# --- Serveur ---
DJANGO_LOG_LEVEL=INFO
# Image Docker : processus gunicorn (environ 2 × cœurs + 1) et options.
WEB_CONCURRENCY=3
GUNICORN_CMD_ARGS=--timeout 60 --graceful-timeout 30

# --- Codes à usage unique (mot de passe oublié, changement de numéro) ---
# email : à l'adresse e-mail du compte ; sms : par SMS (SMS_BACKEND ci-dessous).
OTP_CANAL=email

# --- E-mail ---
# console : e-mails écrits dans le terminal (développement) ; smtp : envoi réel.
EMAIL_BACKEND=console
# Serveur SMTP. Exemples : Brevo (gratuit, 300 e-mails/jour) smtp-relay.brevo.com port 587 ;
# Gmail smtp.gmail.com port 587 avec un « mot de passe d'application ».
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 587 : EMAIL_USE_TLS=True ; 465 : EMAIL_USE_TLS=False et EMAIL_USE_SSL=True.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Expéditeur affiché, avec une adresse autorisée par le serveur SMTP.
DEFAULT_FROM_EMAIL=AgriLink <no-reply@agrilink.tg>

# --- SMS (codes « mot de passe oublié ») : console (terminal) ou twilio ---
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro ou nom d’expéditeur fourni par Twilio, ex. +15005550006
TWILIO_FROM=

# --- Limites anti-abus (par adresse) ---
THROTTLE_CONNEXION=10/min
THROTTLE_INSCRIPTION=5/min
THROTTLE_MOT_DE_PASSE_OUBLIE=10/hour
THROTTLE_REINITIALISATION=10/min
THROTTLE_CHANGEMENT_MOT_DE_PASSE=10/min
THROTTLE_CHANGEMENT_TELEPHONE=10/hour
THROTTLE_MESSAGES=30/min
